PROBLEM 02:
#include<stdio.h>
int main(){
    int n;
    printf("input n:");
    scanf("%d",&n);
    for(int i=1;i<=10;i++){
        printf("%d*%d=%d\n",n,i,n*i);
    }
    return 0;
}
PROBLEM 03:
#include<stdio.h>
int main(){
    int n;
    long long factorial=1;
    printf("input the n:");
    scanf("%d",&n);
    for(int i=2;i<=n;i++){
        factorial*=i;
    }printf("factorial=%lld",factorial);
    return 0;
}
